# ===== 模型可用性监控 配置示例 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会提交到仓库

# sub2api 网关地址（容器网络内直接访问容器名）
SUB2API_URL=http://sub2api:8080

# API Key（必填，仅服务端使用，请勿提交到仓库）
SUB2API_KEY=sk-your-api-key-here

# SQLite 数据库路径
DB_PATH=/data/model-monitor.db

# .env 文件路径覆盖，默认 /app/.env
# ENV_FILE=/app/.env

# 服务监听地址，默认 0.0.0.0
# HOST=0.0.0.0

# 服务监听端口
PORT=8090

# 手动探测 /api/probe 的鉴权 Token；留空则禁用手动探测接口
# PROBE_TOKEN=

# 探测间隔，单位：分钟，默认 5
PROBE_INTERVAL_MINUTES=5

# 慢响应阈值，单位：毫秒，默认 10000
SLOW_THRESHOLD_MS=10000

# 监控时段，支持多段，逗号分隔，格式 HH:MM-HH:MM，含起点与终点；默认 08:00-22:00
MONITOR_WINDOWS=08:00-22:00

# 待监控模型列表，逗号分隔
MODELS=model-a,model-b,model-c
